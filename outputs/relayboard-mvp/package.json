{
  "name": "relayboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,cyan \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "dev:whatsapp": "tsx watch src/whatsapp-bridge/index.ts",
    "dev:telegram": "tsx watch src/telegram-bridge/index.ts",
    "db:migrate": "tsx src/api/migrate.ts",
    "build": "tsc -p tsconfig.node.json && vite build",
    "start:api": "node dist-node/api/server.js",
    "start:worker": "node dist-node/worker/index.js",
    "start:whatsapp": "node dist-node/whatsapp-bridge/index.js",
    "start:telegram": "node dist-node/telegram-bridge/index.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@ounezz/umax": "^1.0.8",
    "@vitejs/plugin-react": "4.3.4",
    "bullmq": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "ioredis": "latest",
    "pg": "latest",
    "qrcode": "latest",
    "react": "latest",
    "react-dom": "latest",
    "teleproto": "^1.229.0",
    "vite": "6.4.3",
    "whatsapp-web.js": "1.34.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/qrcode": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "9.1.2",
    "tsx": "latest",
    "typescript": "5.7.3"
  }
}
