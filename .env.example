NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://relayboard:relayboard@localhost:5432/relayboard
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=change-this-admin-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
SESSION_COOKIE_SECURE=false
APP_ENCRYPTION_KEY=change-this-long-encryption-key
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=104857600
MESSENGER_SEND_MODE=live
QUEUE_DELAY_SCALE=1
QUEUE_NAME=publishing
SEND_TIMEOUT_MS=60000
WHATSAPP_BRIDGE_URL=http://localhost:3010
WHATSAPP_BRIDGE_SECRET=change-this-bridge-secret
WHATSAPP_SESSION_PATH=./data/whatsapp-session
WHATSAPP_CHROMIUM_PATH=
TELEGRAM_BRIDGE_URL=http://localhost:3020
TELEGRAM_BRIDGE_SECRET=change-this-telegram-bridge-secret
TELEGRAM_SESSION_PATH=./data/telegram-session.json
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
