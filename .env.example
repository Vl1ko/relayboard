NODE_ENV=development
CONTACT_IMPORT_ENABLED=false
AI_SEND_MODE=disabled
AI_PROVIDER_MODE=fixture
AI_ALLOW_EXTERNAL_REQUESTS=false
# GigaChat: Authorization key (Base64 Client ID:Client Secret), server only
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Optional trusted CA bundle: NODE_EXTRA_CA_CERTS=/run/secrets/gigachat-ca.pem
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
PORT=3001
DATABASE_URL=postgres://relayboard:relayboard@localhost:5432/relayboard
REDIS_URL=redis://localhost:6379
ADMIN_API_KEY=change-this-admin-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
SESSION_COOKIE_SECURE=false
APP_ENCRYPTION_KEY=change-this-long-encryption-key
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=104857600
ATTACHMENT_RETENTION_DAYS=30
STORAGE_MAINTENANCE_INTERVAL_MS=60000
MESSENGER_SEND_MODE=live
QUEUE_DELAY_SCALE=1
QUEUE_NAME=publishing
SEND_TIMEOUT_MS=60000
WHATSAPP_BRIDGE_URL=http://localhost:3010
WHATSAPP_BRIDGE_SECRET=change-this-bridge-secret
WHATSAPP_SESSION_PATH=./data/whatsapp-session
WHATSAPP_CHROMIUM_PATH=
TELEGRAM_BRIDGE_URL=http://localhost:3020
TELEGRAM_BRIDGE_SECRET=change-this-telegram-bridge-secret
TELEGRAM_SESSION_PATH=./data/telegram-session.json
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Permanent MAX owner (opt-in; keep disabled until the full runtime is configured)
MAX_WORKER_ENABLED=false
MAX_WORKER_HOST=127.0.0.1
MAX_WORKER_PORT=3030
# MAX_WORKER_SECRET=<separate random secret of at least 24 characters>
# MAX_WORKER_URL=http://127.0.0.1:3030

# AI live tests process only these explicitly allowed account UUIDs and author IDs.
AI_TEST_ONLY=true
AI_TEST_ACCOUNT_IDS=
AI_TEST_AUTHOR_IDS=
MAX_POLL_INTERVAL_MS=5000
