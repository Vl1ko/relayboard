+const idKeys = new Set(["chatId", "chatIds", "contactId", "contactIds", "userId", "userIds", "messageId", "messageIds", "cid"]);
+
+function wireValue(value, key = "") {
+    if (Array.isArray(value)) return value.map(item => wireValue(item, key));
+    if (value && typeof value === "object" && !Buffer.isBuffer(value)) {
+        return Object.fromEntries(Object.entries(value).map(([name, item]) => [name, wireValue(item, name)]));
+    }
+    if (value != null && idKeys.has(key)) return new WireId(value);
+    // msgpackr encodes JS numbers outside the 32-bit range as float64 by
+    // default. MAX requires integer timestamps (history `from`, sync markers).
+    if (typeof value === "number" && Number.isSafeInteger(value) && (value > 0xffffffff || value < -0x80000000)) return BigInt(value);
