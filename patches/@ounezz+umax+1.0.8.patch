+    Class: WireId,
+    type: 1,
+    pack(id) {
+        const bytes = Buffer.alloc(9);
+        bytes[0] = id.value < 0 ? 0xd3 : 0xcf;
+        if (id.value < 0) bytes.writeBigInt64BE(id.value, 1);
+        else bytes.writeBigUInt64BE(id.value, 1);
+        return bytes;
+    },
